
<%-include("partials/header.ejs"); %>


<% if (locals.latest) { %>
    <ul>
        <% latest.forEach((blarg) => { %>
        <li>
            <%= blarg %>
            <form action="/update" method="Post">
                <input type="submit" value="Edit">
            </form>
            <button onclick="">Delete</button>
        </li>
        
        <% }) %>
    </ul>
<% } else { %>
    <p>Welcome
        <%= usr %>
    </p>
<% } %>

<form action="/submit" method="POST">
    <label for="blog-post">
        <%= new Date().getHours() %>:
        <%= new Date().getMinutes()%>
    </label>
    <textarea id="blgpst" name="blgpst" placeholder="Express yourself through words!" rows="4" cols="50"></textarea>
    <input type="submit" value="Submit Post">
 </form>


<%-include("partials/footer.ejs"); %>


