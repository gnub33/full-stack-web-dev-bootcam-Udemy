
<%-include("partials/header.ejs"); %>


<% if (locals.latest) { %>
        <% latest.forEach((post) => { %>
            <div class="post">
                <%= post.content %>
                <form action="/posts/<%= post.id %>/delete" method="Post">
                    <button id="del" type="submit">Delete</button>
                </form>
            
                <button type="button" onclick="toggleEdit('<%= post.id %>')">Edit</button>

                <form 
                    id="editForm-<%= post.id %>" 
                    style="display: none" 
                    action="/posts/<%= post.id %>/edit" 
                    method="Post">
                    <textarea id="postItem" name="postItem"><%= post.content %></textarea>
                    <button type="submit">Submit</button>
                </form>
            </div>
        <% }) %>

<% } else { %>
    <p>Welcome
        <%= usr %>
    </p>
<% } %>

<form action="/submit" method="POST">
    <label for="blog-post">
        <%= new Date().getHours() %>:
        <%= new Date().getMinutes()%>
    </label>
    <textarea id="postItem" name="postItem" placeholder="Express yourself through words!" rows="4" cols="50"></textarea>
    <input type="submit" value="Submit Post">
 </form>

<script src="/js/toggle.js"></script>

<%-include("partials/footer.ejs"); %>



