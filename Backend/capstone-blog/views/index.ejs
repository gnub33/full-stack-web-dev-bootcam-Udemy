
<%-include("partials/header.ejs"); %>

<div class="post">
    <% if (locals.latest) { %>
        <% latest.forEach((post) => { %>
            <div class="post-content">
                <%= post.content %>

                <div class="post-actions">
                    <p class="time"><%= formatTime(post.time) %></p>
                    
                    <form action="/posts/<%= post.id %>/delete" method="Post">
                        <button id="del" type="submit">Delete</button>
                    </form>
                
                    <div class="toggle-edit">
                        <button type="button" onclick="toggleEdit('<%= post.id %>')">Edit</button>

                        <form 
                            id="editForm-<%= post.id %>" 
                            style="display: none" 
                            action="/posts/<%= post.id %>/edit" 
                            method="Post">
                            <textarea id="postItem" name="postItem"><%= post.content %></textarea>
                            <button type="submit">Submit</button>
                        </form>
                    </div>
                </div>
            </div>
        <% }) %>

    <% } else { %>
        <p>Welcome
            <%= usr %>
        </p>
    <% } %>
</div>


<form class="form-post" action="/submit" method="POST">
    <label for="blog-post"></label>
    <textarea id="postItem" name="postItem" placeholder="Express yourself through words!" rows="4" cols="50"></textarea>
    <input class="button" type="submit" value="Submit Post">
 </form>

<script src="/js/toggle.js"></script>

<%-include("partials/footer.ejs"); %>



