<!DOCTYPE html>
<html>

<head>
  <title>JokeBox</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Gloria+Hallelujah&family=Titan+One&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" type="text/css" href="styles/main.css">

</head>

<body>
  <section>
    <div class="center">
      <h1>JokeBox</h1>
      <h2>
        Select your parameters to recieve a random joke!
      </h2>
    </div>

    <div class="form-style">
      <form id="myForm" method="POST" action="/">
        <fieldset>
          <legend>JokeBox</legend>

          <label for="cat">Category:</label>
          <select name="cat" id="cat">
            <option value="Any">Any</option>
            <option value="Misc">Misc</option>
            <option value="Programming">Programming</option>
            <option value="Dark">Dark</option>
            <option value="Pun">Pun</option>
            <option value="Spooky">Spooky</option>
            <option value="Christmas">Xmas</option>
          </select>

          <div class="checks">
            <p>Optional Flags</p>

            <input type="checkbox" id="nswf" name="blacklist" value="NSFW">
            <label for="nsfw">NSFW</label>
            <input type="checkbox" id="religion" name="blacklist" value="religion">
            <label for="religion">Religion</label>
            <input type="checkbox" id="political" name="blacklist" value="political">
            <label for="political">Political</label>
            <input type="checkbox" id="racist" name="blacklist" value="racist">
            <label for="racist">Racist</label>
            <input type="checkbox" id="sexist" name="blacklist" value="sexist">
            <label for="sexist">Sexist</label>
            <input type="checkbox" id="explicit" name="blacklist" value="explicit">
            <label for="explicit">Explicit</label>
          </div>
          
          
          <label for="lang">Language:</label>
          <select name="lang" id="lang">
            <option value="en" selected>English</option>
            <option value="cs">Czech</option>
            <option value="pt">Portuguese</option>
            <option value="fr">French</option>
            <option value="es">Spanish</option>
            <option value="de">German</option>
          </select>
          
          <div class="checks">
            <p>Joke Type</p>
            <input type="radio" id="single" name="type" value="single">
            <label for="single">Single</label>
            
            <input type="radio" id="twopart" name="type" value="twopart">
            <label for="twopart">Two Part</label>
          </div>

          <label for="cont">Contains:</label>
          <input type="text" id="cont" name="cont">
          
          <input type="submit" value="Get Joke" id="submit">
        </fieldset>
      </form>

    <div class="joke">
      <% if (locals.data) { %>
        <div>
          <% if (locals.data.joke) { %>
            <%= data.joke %>
          <% } else if(locals.data.setup) { %>
            <p><%= data.setup %></p>
            <p><%= data.delivery %></p>
          <% } %>
        </div>
      <% } %>
      </section>


  </div>
  <% if(locals.error) { %>
      <p>
        <%= error %>
      </p>
  <% } %>

</body>

</html>